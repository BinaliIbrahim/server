PORT=5000

# Firebase Admin (service account)
PROJECT_ID=
CLIENT_EMAIL=
PRIVATE_KEY=

# PayChangu
PAYCHANGU_SECRET_KEY=

# Email notifications (Gmail app password recommended)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# URLs (no trailing slash)
APP_ORIGIN=https://salesmanagement.ibratechinnovations.com
API_PUBLIC_ORIGIN=https://app.ibratechinnovations.com

# Comma-separated extra CORS origins (optional)
CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Set false for local dev to skip Firestore listeners (saves quota)
ENABLE_EVENT_WATCHERS=false

# MRA Electronic Invoicing System (EIS)
# Request a Product ID from MRA for production; use sandbox for development
EIS_PRODUCT_ID=RetailFlow-POS/1.0.0
EIS_PRODUCT_VERSION=1.0.0
